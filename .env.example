# ==============================================================================
# OpenProfiles Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Supabase PostgreSQL) - REQUIRED
# ------------------------------------------------------------------------------
# Your Supabase PostgreSQL connection string.
# On Supabase: Project Settings -> Database -> Connection string -> URI
# NOTE: For Render deployments, use the Transaction / Session Pooler connection string
# (port 6543 or 5432) or direct connection. IPv4 is supported through pooler.
#
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Optional alias (DATABASE_URL takes precedence if both are set):
# SUPABASE_DATABASE_URL=postgresql://...

# ------------------------------------------------------------------------------
# 2. ENCRYPTION & SECURITY - REQUIRED
# ------------------------------------------------------------------------------
# 32-byte secret key represented as a 64-character hexadecimal string.
# OpenProfiles uses this key with AES-256-GCM to encrypt your Stremio credentials,
# profile states, add-on configurations, and library snapshots.
#
# IMPORTANT:
# - Once generated, NEVER lose or delete this key! If changed, previously encrypted
#   profiles cannot be decrypted.
# - Do NOT store this key in Supabase or GitHub.
# - Generate a fresh random key using:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=replace_with_64_character_hex_string_from_above_command

# ------------------------------------------------------------------------------
# 3. HOSTING & NETWORK CONFIGURATION (Render / Public URL) - REQUIRED
# ------------------------------------------------------------------------------
# The public HTTPS URL where this service is reachable on the internet.
# Render provides this once your Web Service is created (e.g., https://my-openprofiles.onrender.com).
# Used for Stremio add-on manifest generation and cookie security.
PUBLIC_URL=https://your-openprofiles-service.onrender.com

# Port to listen on (Render automatically supplies $PORT, defaults to 7000)
PORT=7000

# Node environment
NODE_ENV=production

# ------------------------------------------------------------------------------
# 4. ACCESS CONTROL (Optional)
# ------------------------------------------------------------------------------
# ACCESS:
#   'owner' (default) - Only the first Stremio account that signs in can use this server.
#   'list'            - Only emails listed in ALLOWED_EMAILS can create profiles / sign in.
#   'open'            - Anyone with a Stremio account can create profiles on this server.
ACCESS=owner

# ALLOWED_EMAILS:
# Comma-separated list of allowed Stremio account emails when ACCESS=list.
# ALLOWED_EMAILS=user1@example.com,user2@example.com

# MAX_ACCOUNTS:
# Maximum number of accounts this server accepts (default: 50).
MAX_ACCOUNTS=50

# ADMINS:
# Comma-separated list of Stremio emails that have server admin privileges.
# The server owner (first signed-in user) is always an admin.
# ADMINS=admin@example.com

# ------------------------------------------------------------------------------
# 5. MAINTENANCE & CLEANUP (Optional)
# ------------------------------------------------------------------------------
# REMOVE_UNUSED_DAYS:
# Automatically remove inactive accounts not used from Stremio or web in X days.
# Set to 0 to disable automatic pruning. Default: 90.
REMOVE_UNUSED_DAYS=90

# LOG_LEVEL:
# Logging verbosity: 'error', 'warn', 'info' (default), 'debug'.
LOG_LEVEL=info

# TRUST_PROXY:
# Express proxy trust setting. Default: 'loopback'. Set to 'true' or '1' on Render
# if you need accurate client IP logging behind Render's reverse proxy.
TRUST_PROXY=1
